---
import StatusPip from './StatusPip.astro';

interface Candidate {
  site: string;
  url: string;
  title: string;
  sku?: string | null;
  score: number;
  notes?: string[];
}

type Status = 'missing' | 'confirmed' | 'purchased';

interface Pick {
  site: string;
  url: string;
  sku?: string | null;
  title: string;
  score?: number;
  notes?: string[];
}

interface Event {
  status: Status;
  at: Date;
  pick?: Pick;
  note?: string;
}

interface Props {
  id: string;
  num: number;
  name: string;
  qty: number;
  desc: string;
  alternates: Candidate[];
  history: Event[];
}

const { id, num, name, qty, desc, alternates, history } = Astro.props;

function clean(title: string): string {
  return title.replace(/&#215;/g, '×').replace(/&#8211;/g, '–').replace(/&amp;/g, '&');
}

function formatDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}

function pickLabel(p: Pick): string {
  return p.sku ?? new URL(p.url).hostname.replace(/^www\./, '');
}

const lastEvent: Event | undefined = history.at(-1);
const status: Status = lastEvent?.status ?? 'missing';
const pick: Pick | undefined = lastEvent?.pick;
const isPicked = !!pick;

// Winner card prefers the picked candidate from the last event; otherwise the top alternate.
const winner: Pick | Candidate | null = pick ?? (alternates.length > 0 ? alternates[0] : null);
const restAlternates: Candidate[] = isPicked ? alternates : alternates.slice(1);
const itemNum = String(num).padStart(2, '0');
---

<article class={`part ${status === 'purchased' ? 'is-purchased' : ''}`} id={id}>
  <div class="part-id">№ {itemNum}</div>
  <div class="part-body">
    <header class="part-head">
      <h3 class="part-name">{name}</h3>
      {qty > 1 && <span class="part-qty">× {qty}</span>}
    </header>
    <p class="part-desc">{desc}</p>

    {winner ? (
      <div class={`candidate ${isPicked ? 'is-winner' : ''}`}>
        <span class="candidate-tag">{isPicked ? 'elegido' : 'mejor coincidencia'}</span>
        <div class="candidate-body">
          <a class="candidate-title" href={winner.url} target="_blank" rel="noopener">
            {clean(winner.title)}
          </a>
          <div class="candidate-meta">
            <span>sitio · {winner.site}</span>
            {winner.sku && <span>sku · {winner.sku}</span>}
            {winner.score !== undefined && (
              <span class="candidate-score">puntaje {winner.score}</span>
            )}
          </div>
          {winner.notes && winner.notes.length > 0 && (
            <div class="candidate-notes">{winner.notes.join('  ·  ')}</div>
          )}
        </div>
      </div>
    ) : (
      <div class="no-candidates">
        No encontrado en este catálogo — buscar en otro lado o consultar al vendedor directamente.
      </div>
    )}

    {restAlternates.length > 0 && (
      <details class="alternates">
        <summary>{restAlternates.length} {restAlternates.length === 1 ? 'alternativa' : 'alternativas'}</summary>
        {restAlternates.map((c) => (
          <div class="candidate">
            <span class="candidate-tag">alt</span>
            <div class="candidate-body">
              <a class="candidate-title" href={c.url} target="_blank" rel="noopener">
                {clean(c.title)}
              </a>
              <div class="candidate-meta">
                <span>sitio · {c.site}</span>
                {c.sku && <span>sku · {c.sku}</span>}
                <span class="candidate-score">puntaje {c.score}</span>
              </div>
              {c.notes && c.notes.length > 0 && (
                <div class="candidate-notes">{c.notes.join('  ·  ')}</div>
              )}
            </div>
          </div>
        ))}
      </details>
    )}

    {history.length > 0 && (
      <ol class="timeline">
        {history.map((ev) => (
          <li class="timeline-entry">
            <span class="timeline-date">{formatDate(ev.at)}</span>
            <span class={`timeline-status pip-${ev.status}`}>
              {ev.status === 'missing' ? 'falta' : ev.status === 'confirmed' ? 'confirmado' : 'comprado'}
            </span>
            {ev.pick && (
              <a class="timeline-pick" href={ev.pick.url} target="_blank" rel="noopener">
                {pickLabel(ev.pick)}
              </a>
            )}
            {ev.note && <span class="timeline-note">{ev.note}</span>}
          </li>
        ))}
      </ol>
    )}
  </div>
  <div class="part-status">
    <StatusPip status={status} />
  </div>
</article>
